new file mode 100644
--- /dev/null
+++ b/src/main_wasm.cpp
@@ -0,0 +1,54 @@
+// Copyright (c) 2012-2018, The CryptoNote developers, The Bytecoin developers.
+// Licensed under the GNU Lesser General Public License. See LICENSE for details.
+
+// walletd for the browser (WebAssembly). The equivalent of `walletd --app`:
+// no wallet is opened at start, the page creates or opens one through ext_create_wallet / ext_open_wallet.
+// JSON RPC requests come from JavaScript through Module.worker_http_request (see http/Server.cpp),
+// the node is reached with fetch() at --bytecoind-remote-address, wallet and cache live in IndexedDB.
+
+#include <emscripten/bind.h>
+#include <emscripten/emscripten.h>
+#include <iostream>
+#include "Core/Config.hpp"
+#include "Core/Currency.hpp"
+#include "Core/WalletNodeExt.hpp"
+#include "common/BIPs.hpp"
+#include "common/CommandLine.hpp"
+#include "common/exception.hpp"
+#include "logging/ConsoleLogger.hpp"
+#include "version.hpp"
+
+using namespace cn;
+
+// walletd has no RPC for a new mnemonic (the CLI has --create-mnemonic), so the page gets one from here.
+static std::string create_mnemonic() { return Bip32Key::create_random_bip39_mnemonic(256); }
+static std::string check_mnemonic(std::string mnemonic) {
+	try {
+		return Bip32Key::check_bip39_mnemonic(mnemonic);
+	} catch (const std::exception &) {
+		return std::string{};
+	}
+}
+
+EMSCRIPTEN_BINDINGS(walletd_wasm) {
+	emscripten::function("create_mnemonic", &create_mnemonic);
+	emscripten::function("check_mnemonic", &check_mnemonic);
+}
+
+int main(int argc, const char *argv[]) try {
+	// Everything must outlive main(): the runtime keeps running and calls back into these objects.
+	static common::CommandLine cmd(argc, argv);
+	static Config config(cmd);
+	// The wallet cache is an in-memory DB saved whole to IndexedDB on each commit. A browser tab or a phone app
+	// can be closed at any moment, so commit far more often than desktop walletd (111 s).
+	config.db_commit_period_wallet_cache = 15;
+	static Currency currency(config);
+	static logging::ConsoleLogger logger;
+	static WalletNodeExt wallet_node(config, currency, logger);
+	std::cout << "walletd " << cn::app_version() << " (wasm) ready, node " << config.bytecoind_remote_ip << ":"
+	          << config.bytecoind_remote_port << std::endl;
+	return 0;
+} catch (const std::exception &ex) {
+	std::cout << "walletd (wasm) failed to start - " << common::what(ex) << std::endl;
+	return 1;
+}

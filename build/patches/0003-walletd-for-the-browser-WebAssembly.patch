+void WalletPreparatorMulticore::add_work(std::vector<api::cnd::SyncBlocks::RawBlockCompact> &&new_work) {
+	for (auto &&b : new_work) {
+		total_block_size += b.header.transactions_size;
+		work.push_back(WorkItem{});
+		work.back().block.raw_block = std::move(b);

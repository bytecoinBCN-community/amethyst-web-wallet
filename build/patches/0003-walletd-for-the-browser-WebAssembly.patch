+
+void WalletPreparatorMulticore::add_work(const Hash &tid, size_t size, TransactionPrefix &&new_work) {
+	total_mempool_count += 1;
+	work.push_back(WorkItem{});
+	work.back().is_tx     = true;
+	work.back().pwtx.tid  = tid;
+	work.back().pwtx.size = size;
+	work.back().pwtx.tx   = std::move(new_work);
+	if (!timer.is_set())
+		timer.once(0);
+}
+
+void WalletPreparatorMulticore::on_timer() {
+	const auto start = std::chrono::steady_clock::now();
+	while (!work.empty()) {
+		auto &w = work.front();
+		if (w.is_tx) {
+			w.pwtx.prepare(m_o_handler, m_view_secret_key);
+			if (!t_handler(w.pwtx)) {
+				c_handler();
+				return;  // retried when new work arrives
+			}
+			total_mempool_count -= 1;
+		} else {
+			w.block.prepare(m_o_handler, m_view_secret_key);
+			if (!b_handler(w.block)) {
+				c_handler();
+				return;  // retried when new work arrives
+			}
+			total_block_size -= w.block.raw_block.header.transactions_size;
+		}
+		work.pop_front();
+		if (std::chrono::steady_clock::now() - start > std::chrono::milliseconds(50))
+			break;
+	}
+	c_handler();
+	if (!work.empty())
+		timer.once(0);
+}

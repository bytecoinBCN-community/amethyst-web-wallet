 using namespace cn;
 
+#ifdef __EMSCRIPTEN__
+#include <cstring>
+#include "common/StringTools.hpp"
+#include "crypto/chacha.hpp"
+#include "crypto/crypto.hpp"
+extern "C" {
+#include "hmac/hmac_sha2.h"
+}
+
+void pkcs5_pbkdf2_hmac_sha512(const uint8_t *pass, size_t passlen, const uint8_t *salt, size_t saltlen, size_t iter,
+    size_t keylen, uint8_t *out);  // common/BIPs.cpp
+
+// Wallet file in IndexedDB holds the mnemonic. With a non-empty password (PIN) it is stored as
+// "bcnwallet2" | salt[16] | iv[8] | ChaCha20(json) | HMAC-SHA256(everything before | storage name)
+// with keys from PBKDF2-HMAC-SHA512(password, salt, 250000). The MAC covers the IndexedDB key the file
+// is stored under, so a file copied into another wallet's slot does not open.
+// "bcnwallet1" (100000 iterations, MAC without the name) is still read and rewritten as v2 on open.
+// Files without a magic are plain JSON (oldest builds).
+namespace {
+struct WalletFileFormat {
+	const char *magic;
+	size_t iterations;
+	bool mac_covers_name;
+};
+const WalletFileFormat WALLET_FILE_V1{"bcnwallet1", 100000, false};
+const WalletFileFormat WALLET_FILE_V2{"bcnwallet2", 250000, true};
+const WalletFileFormat &WALLET_FILE_CURRENT = WALLET_FILE_V2;
+const size_t MAGIC_SIZE = 10, SALT_SIZE = 16, IV_SIZE = 8, MAC_SIZE = 32;
+
+struct WalletFileKeys {
+	crypto::chacha_key enc;
+	uint8_t mac[32]{};
+	WalletFileKeys(const std::string &password, const uint8_t *salt, size_t iterations) {
+		uint8_t out[64]{};
+		pkcs5_pbkdf2_hmac_sha512(reinterpret_cast<const uint8_t *>(password.data()), password.size(), salt,
+		    SALT_SIZE, iterations, 64, out);
+		memcpy(enc.data, out, 32);
+		memcpy(mac, out + 32, 32);
+		memset(out, 0, sizeof(out));
+	}
+	~WalletFileKeys() { memset(mac, 0, sizeof(mac)); }
+};
+
+void wallet_file_mac(const WalletFileFormat &format, const WalletFileKeys &keys, const std::string &data,
+    size_t signed_size, const std::string &storage_name, uint8_t *mac) {
+	std::string message = data.substr(0, signed_size);
+	if (format.mac_covers_name)
+		message += storage_name;
+	hmac_sha256(keys.mac, 32, reinterpret_cast<const uint8_t *>(message.data()), static_cast<unsigned>(message.size()),
+	    mac, MAC_SIZE);
+}
+
+std::string encrypt_wallet_file(const std::string &json, const std::string &password, const std::string &storage_name) {
+	if (password.empty())
+		return json;
+	const WalletFileFormat &format = WALLET_FILE_CURRENT;
+	uint8_t salt[SALT_SIZE];
+	crypto::chacha_iv iv;
+	crypto::generate_random_bytes(salt, sizeof(salt));
+	crypto::generate_random_bytes(iv.data, sizeof(iv.data));
+	WalletFileKeys keys(password, salt, format.iterations);
+	std::string result = format.magic;
+	result.append(reinterpret_cast<const char *>(salt), SALT_SIZE);
+	result.append(reinterpret_cast<const char *>(iv.data), IV_SIZE);
+	const size_t body = result.size();
+	result.resize(body + json.size());
+	crypto::chacha(20, json.data(), json.size(), keys.enc, iv, &result[body]);
+	uint8_t mac[MAC_SIZE];
+	wallet_file_mac(format, keys, result, result.size(), storage_name, mac);
+	result.append(reinterpret_cast<const char *>(mac), MAC_SIZE);
+	return result;
+}
+
+// nullptr for a plain JSON file
+const WalletFileFormat *wallet_file_format(const std::string &data) {
+	for (const WalletFileFormat *f : {&WALLET_FILE_V1, &WALLET_FILE_V2})
+		if (common::starts_with(data, f->magic))
+			return f;
+	return nullptr;
+}
+
+// Returns false on wrong password, damaged file or a file stored under another name.
+bool decrypt_wallet_file(const WalletFileFormat &format, const std::string &data, const std::string &password,
+    const std::string &storage_name, std::string *json) {
+	const size_t header = MAGIC_SIZE + SALT_SIZE + IV_SIZE;
+	if (data.size() < header + MAC_SIZE)
+		return false;
+	const auto *salt = reinterpret_cast<const uint8_t *>(data.data()) + MAGIC_SIZE;
+	crypto::chacha_iv iv;
+	memcpy(iv.data, salt + SALT_SIZE, IV_SIZE);
+	WalletFileKeys keys(password, salt, format.iterations);
+	const size_t signed_size = data.size() - MAC_SIZE;
+	uint8_t mac[MAC_SIZE];
+	wallet_file_mac(format, keys, data, signed_size, storage_name, mac);
+	uint8_t diff = 0;
+	for (size_t i = 0; i != MAC_SIZE; ++i)
+		diff |= mac[i] ^ static_cast<uint8_t>(data[signed_size + i]);
+	if (diff != 0)
+		return false;
+	json->resize(signed_size - header);
+	crypto::chacha(20, data.data() + header, json->size(), keys.enc, iv, &(*json)[0]);
+	return true;
+}
+}  // namespace
+
+void WalletNodeExt::save_wallet_file(std::function<void()> &&on_saved) {
+	auto *wallet_json = dynamic_cast<WalletHDJson *>(wallet.get());
+	if (!wallet_json)
+		return;
+	const std::string storage_name = wallet->get_cache_name() + ".wallet.memory";
+	m_wallet_file_data = encrypt_wallet_file(wallet_json->save_json_data(), m_wallet_password, storage_name);
+	wallet_save_op     = std::make_unique<platform::AsyncIndexDBOperation>(
+        storage_name, m_wallet_file_data.data(), m_wallet_file_data.size(), std::move(on_saved));
+}

# Response headers for Cloudflare Pages / Netlify (GitHub Pages ignores this file; Apache uses .htaccess).
# The CSP is also set as a <meta> in index.html; frame-ancestors only works as a header.
# no-cache: the browser asks the server before using its copy, so an update is never served stale
# (walletd.js and walletd.wasm only work together).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache
